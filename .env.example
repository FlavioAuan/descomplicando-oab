# Database
DATABASE_URL=mysql://usuario:senha@localhost:3306/descomplicando

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo que assina o cookie de login (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your-auth-secret

# Email (SMTP) — usado na recuperação de senha. Padrão: Gmail (smtp.gmail.com, porta 465).
# SMTP_USER = seu Gmail; SMTP_PASS = "senha de app" do Google (não a senha normal).
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app
# Opcionais: outro provedor (porta 465 usa SSL; 587 usa STARTTLS) e remetente exibido
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=465
# SMTP_FROM=DescomplicandOAB <seuemail@gmail.com>

# Mercado Pago — normalmente configurado no admin (Vendas). Se definidas aqui, têm prioridade.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=...

# Pasta onde os arquivos enviados (PDFs, materiais) são salvos.
# No Easypanel, é o caminho onde o volume está montado.
STORAGE_DIR=./storage

# ── AI Providers ───────────────────────────────────────────────────────────────
# Keys are NEVER stored in the database — set them here only.
# The active provider and model are configured in the admin panel (Configurações IA).

# Groq — free tier, recommended primary provider (console.groq.com)
GROQ_API_KEY=your-groq-api-key

# OpenRouter — used as automatic fallback when Groq hits its daily limit (openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI — only used when explicitly selected in Configurações IA (platform.openai.com)
OPENAI_API_KEY=your-openai-api-key

# Optional: override the default OpenRouter fallback model (default: mistralai/mistral-7b-instruct:free)
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
